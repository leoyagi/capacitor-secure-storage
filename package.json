{
  "name": "@aparajita/capacitor-secure-storage",
  "version": "8.0.0",
  "description": "Capacitor 7+ plugin that provides secure storage for the iOS and Android",
  "author": "Aparajita Fishman",
  "license": "MIT",
  "type": "module",
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs",
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "format": "prettier --write --cache --log-level error \"**/*.{js,cjs,mjs,ts,vue,md,json,css}\"",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "builder": "vue-tsc ${SOURCE_MAP:-} && rollup -c rollup.config.mjs",
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "watch": "nodemon --exec 'pnpm build.dev'",
    "prepublishOnly": "npm run build",
    "prerelease": "pnpm build",
    "tag.preview": "pnpm tag --dry-run",
    "release": "./scripts/release.sh"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "storage",
    "encryption"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "swiftlint": "@ionic/swiftlint-config",
  "prettier": "@ionic/prettier-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/leoyagi/capacitor-secure-storage.git"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/js": "^9.39.2",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@types/node": "^24.10.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "neostandard": "^0.12.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prettier-plugin-java": "^2.8.0",
    "rimraf": "^6.1.2",
    "rollup": "^4.55.1",
    "simple-git-hooks": "^2.13.1",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "vue-tsc": "~3.1.8"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^7.1.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  }
}
